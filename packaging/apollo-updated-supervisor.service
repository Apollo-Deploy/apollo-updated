[Unit]
Description=Apollo package generation supervisor broker
Requires=apollo-updated-supervisor.socket
After=local-fs.target

[Service]
Type=simple
Sockets=apollo-updated-supervisor.socket
User=root
Group=root
ExecStart=/usr/sbin/apollo-updated supervisor-broker
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/apollo-updated-supervisor /etc/systemd/system /run/systemd/system /run/apollo-updated-generations
ReadOnlyPaths=/etc/apollo-updated /var/lib/apollo-updated
UMask=0077
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
